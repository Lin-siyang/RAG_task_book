# 复制本文件为 .env 并填入真实值:.env 已被 .gitignore 排除,不会提交

# ── Embedding(jumengai 中转,OpenAI 兼容接口;单次请求最多 20 条,脚本内已按 20 分批)──
EMBEDDING_MODEL="qwen3.7-text-embedding-flash"
EMBEDDING_URL="https://www.jumengai.com/v1"
EMBEDDING_API_KEY="sk-xxxx"

# ── Chat 模型(DeepSeek 官方 API)──
DEEPSEEK_API_KEY="sk-xxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ── 重排模型(hybrid_search/ 使用;本地 ModelScope 下载的 BGE cross-encoder)──
BGE_RERANKER_PATH="F:/Modelscope_Models/bge-reranker-v2-m3"

# ── LangSmith 追踪(可选;rag/config 导入时已设置默认值)──
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY="lsv2_xxxx"

# ── API 服务(api/main.py)──
# CORS 允许的前端地址,逗号分隔白名单(浏览器凭据模式下禁止 "*")
API_ALLOW_ORIGINS="http://localhost:5173,http://localhost:3000"
